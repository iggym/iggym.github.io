    <script>
        const checkAttn = document.getElementById('layer-attn');
        const checkMlp = document.getElementById('layer-mlp');
        
        const barCode = document.getElementById('bar-code');
        const barUrgency = document.getElementById('bar-urgency');
        
        const txtCode = document.getElementById('txt-code');
        const txtUrgency = document.getElementById('txt-urgency');
        const formulaReadout = document.getElementById('formula-readout');

        // Bind update triggers to runtime control elements
        checkAttn.addEventListener('change', updateVectorSpaceSimulation);
        checkMlp.addEventListener('change', updateVectorSpaceSimulation);

        function updateVectorSpaceSimulation() {
            // Establish static baseline footprint values (Token Embedding base metrics)
            let finalCodeVal = 15;
            let finalUrgencyVal = 5;
            let formulaString = "Vector State: x = x₀";

            if (checkAttn.checked) {
                finalCodeVal += 45;       // Attention maps structural context
                finalUrgencyVal += 20;    // Basic attention interaction shifts
                formulaString += " + a₁";
            }
            if (checkMlp.checked) {
                finalCodeVal += 30;       // MLP projects into dense syntax features
                finalUrgencyVal += 65;    // Dense layer triggers abstract classification
                formulaString += " + m₁";
            }

            // Animate layout bar width percentages matching state calculations
            barCode.style.width = `${finalCodeVal}%`;
            barUrgency.style.width = `${finalUrgencyVal}%`;

            // Print textual updates out to tracking labels
            txtCode.innerText = `${finalCodeVal}%`;
            txtUrgency.innerText = `${finalUrgencyVal}%`;
            formulaReadout.innerText = formulaString;
        }
    </script>
